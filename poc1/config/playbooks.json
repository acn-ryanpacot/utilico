         "steps": ["REPROCESS_INTEGRATION_MESSAGE", "STOP_SA", "CORRECT_MDM_READS", "REGENERATE_DRAFT_BILL", "CANCEL_DRAFT_BILL", "CLOSE_TODO", "ADD_CRM_NOTE"]},
        {"option_id": "RELEASE_AS_IS", "label": "Release as-is", "steps": [], "terminal": "RELEASE_AS_IS"}
      ]
    },
    "ID_MISMATCH": {
      "label": "ID mismatch",
      "causes": ["C3"],
      "options": [
        {"option_id": "CORRECT_AND_REBILL", "label": "Correct and rebill (after the Analyst confirms the match)", "recommended": true, "requires_match_confirmed": true,
         "steps": ["CORRECT_PREMISE_REFERENCE", "REPROCESS_INTEGRATION_MESSAGE", "STOP_SA", "CORRECT_MDM_READS", "REGENERATE_DRAFT_BILL", "CANCEL_DRAFT_BILL", "CLOSE_TODO", "ADD_CRM_NOTE"]},
        {"option_id": "RELEASE_AS_IS", "label": "Release as-is", "steps": [], "terminal": "RELEASE_AS_IS"}
      ]
    },
    "STOP_TIMING": {
      "label": "Timing race",
      "causes": ["C6"],
      "options": [
        {"option_id": "PROCESS_STOP_THEN_FINAL", "label": "Process stop now, then final-bill", "recommended": true,
         "steps": ["REPROCESS_INTEGRATION_MESSAGE", "STOP_SA", "CORRECT_MDM_READS", "REGENERATE_DRAFT_BILL"]},
        {"option_id": "DEFER_TO_NEXT_RUN", "label": "Defer to next run", "steps": [], "terminal": "DEFER"}
      ]
    },
    "NONPAY_WINDOW": {
      "label": "Non-pay window",
      "causes": ["C4+C5"],
      "options": [
        {"option_id": "ZERO_DAYS_KEEP_FIXED", "label": "Zero disconnected days, keep fixed charges", "recommended": true,
