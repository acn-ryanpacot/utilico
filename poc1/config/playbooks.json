        {"option_id": "RELEASE_AS_IS", "label": "Release as-is", "steps": [], "terminal": "RELEASE_AS_IS"}
      ]
    },
    "REMEDIATE": {
      "label": "Already billed",
      "causes": [],
      "options": [
        {"option_id": "CREDIT_AND_NOTIFY", "label": "Credit and notify", "recommended": true,
         "steps": ["CORRECT_PREMISE_REFERENCE", "CREATE_CREDIT_MEMO", "ADD_CRM_NOTE", "DRAFT_CUSTOMER_LETTER", "DRAFT_REGULATOR_RESPONSE"]}
      ]
    }
  }
