{
  "_comment": "BEX ticket lifecycle (workflow_rules.md v2.0 §5) as a data-driven state machine. The server rejects any transition not listed here. 'personas' = humans allowed; 'actors' = system/agent actors allowed. 'reason' = written reason required (SoD-5). 'requires' = extra conditions checked by the engine.",
  "version": "2.0",
  "states": ["NEW", "INVESTIGATING", "TRIAGE", "AWAITING_DECISION", "PENDING_FINANCE", "PLAN_APPROVAL", "IN_PROGRESS",
             "VERIFYING", "COMMS_APPROVAL", "READY_TO_RELEASE", "RESOLVED", "CLOSED", "CANCELLED"],
  "terminal": ["CLOSED", "CANCELLED"],
  "done_for_sla": ["RESOLVED", "CLOSED", "CANCELLED"],
  "transitions": [
    {"id": "T_START",            "from": "NEW",               "to": "INVESTIGATING",     "actors": ["sys.gate"],           "label": "auto"},
    {"id": "T_EVIDENCE",         "from": "INVESTIGATING",     "to": "TRIAGE",            "actors": ["agent.investigator"], "label": "evidence ready"},
    {"id": "T_TRIAGE",           "from": "TRIAGE",            "to": "AWAITING_DECISION", "personas": ["BILLING_OPS"],      "label": "Analyst confirms (incl. ID match if G5)", "requires": ["match_resolved"]},
    {"id": "T_CANCEL_FP",        "from": "TRIAGE",            "to": "CANCELLED",         "personas": ["DRI"],              "label": "false positive (DRI approves)", "reason": true, "requires": ["cancel_requested"]},
    {"id": "T_CANCEL_DUP",       "from": "AWAITING_DECISION", "to": "CANCELLED",         "personas": ["DRI"],              "label": "cancel as duplicate", "reason": true},
    {"id": "T_TO_FINANCE",       "from": "AWAITING_DECISION", "to": "PENDING_FINANCE",   "personas": ["DRI"],              "label": "DoA L2"},
    {"id": "T_DECIDE",           "from": "AWAITING_DECISION", "to": "PLAN_APPROVAL",     "personas": ["BILLING_OPS", "DRI"], "label": "decision within DoA"},
    {"id": "T_OVERRIDE_RELEASE", "from": "AWAITING_DECISION", "to": "READY_TO_RELEASE",  "personas": ["DRI"],              "label": "override release as-is", "reason": true},
    {"id": "T_FIN_APPROVE",      "from": "PENDING_FINANCE",   "to": "PLAN_APPROVAL",     "personas": ["FINANCE"],          "label": "Finance approves"},
    {"id": "T_FIN_APPROVE_REL",  "from": "PENDING_FINANCE",   "to": "READY_TO_RELEASE",  "personas": ["FINANCE"],          "label": "Finance approves override release as-is"},
    {"id": "T_FIN_REJECT",       "from": "PENDING_FINANCE",   "to": "AWAITING_DECISION", "personas": ["FINANCE"],          "label": "Finance rejects", "reason": true},
    {"id": "T_PLAN_APPROVE",     "from": "PLAN_APPROVAL",     "to": "IN_PROGRESS",       "personas": ["BILLING_OPS", "DRI"], "label": "plan approved", "requires": ["is_decision_maker"]},
    {"id": "T_PLAN_RETURN",      "from": "PLAN_APPROVAL",     "to": "AWAITING_DECISION", "personas": ["BILLING_OPS", "DRI"], "label": "plan sent back", "reason": true, "requires": ["is_decision_maker"]},
    {"id": "T_PLAN_INVALID",     "from": "PLAN_APPROVAL",     "to": "AWAITING_DECISION", "actors": ["agent.executor"],     "label": "plan could not be built"},
    {"id": "T_STEPS_DONE",       "from": "IN_PROGRESS",       "to": "VERIFYING",         "actors": ["agent.executor"],     "label": "steps complete"},
    {"id": "T_STEP_FAILED",      "from": "IN_PROGRESS",       "to": "AWAITING_DECISION", "actors": ["agent.executor"],     "label": "step failed"},
    {"id": "T_VERIFY_COMMS",     "from": "VERIFYING",         "to": "COMMS_APPROVAL",    "actors": ["sys.verifier"],       "label": "dispute or regulatory flag"},
    {"id": "T_VERIFY_RELEASE",   "from": "VERIFYING",         "to": "READY_TO_RELEASE",  "actors": ["sys.verifier"],       "label": "pass, PREVENT"},
    {"id": "T_VERIFY_RESOLVED",  "from": "VERIFYING",         "to": "RESOLVED",          "actors": ["sys.verifier"],       "label": "pass, ADVANCE or REMEDIATE"},
    {"id": "T_VERIFY_FAIL",      "from": "VERIFYING",         "to": "AWAITING_DECISION", "actors": ["sys.verifier"],       "label": "fail"},
    {"id": "T_COMMS_RELEASE",    "from": "COMMS_APPROVAL",    "to": "READY_TO_RELEASE",  "personas": ["DRI"],              "label": "DRI approves, PREVENT"},
    {"id": "T_COMMS_RESOLVED",   "from": "COMMS_APPROVAL",    "to": "RESOLVED",          "personas": ["DRI"],              "label": "DRI approves, REMEDIATE / ADVANCE"},
    {"id": "T_RELEASE",          "from": "READY_TO_RELEASE",  "to": "RESOLVED",          "personas": ["BILLING_OPS"],      "label": "Analyst releases bill / confirms cancellation"},
    {"id": "T_REOPEN",           "from": "RESOLVED",          "to": "AWAITING_DECISION", "personas": ["DRI"],              "label": "reopened within 5 business days", "reason": true, "requires": ["within_reopen_window"]},
    {"id": "T_CLOSE",            "from": "RESOLVED",          "to": "CLOSED",            "actors": ["sys.gate"],           "label": "5 business days, no reopen"}
  ],
  "reason_required": ["OVERRIDE", "REJECT", "CANCEL", "PRIORITY_CHANGE", "REOPEN"],
  "closure_codes": {
    "RESOLVED_CORRECTED": "Draft corrected and released",
    "RESOLVED_DRAFT_CANCELLED": "Draft cancelled; no bill was due",
    "RESOLVED_ACCOUNT_FIXED": "ADVANCE: account fixed before the next cycle",
    "RESOLVED_CREDIT_POSTED": "REMEDIATE: credit posted and customer notified",
    "RESOLVED_RELEASED_AS_IS": "Override; reason mandatory",
    "CANCELLED_FALSE_POSITIVE": "Gate was wrong; DRI approved",
    "CANCELLED_DUPLICATE": "Merged into another ticket"
  }
}
