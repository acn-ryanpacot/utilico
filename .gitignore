# Runtime state written by poc1/server.py (case state, sandbox overlays, audit log)
poc1/state/
# Pre-v2.0 state archived by the migration (never deleted by the app)
poc1/state_archive/

# AI-Utilico: virtual env, downloaded model files, runtime state (all recreated by scripts/setup.py / run.py)
utilico/.venv/
utilico/models/
utilico/state/
utilico/.pytest_cache/
# AI-Utilico: local model settings with the API key (template: utilico/.env.example)
utilico/.env

# Python
__pycache__/
*.pyc

# Local tooling / editor settings
.claude/
.vscode/
.idea/

# Local copies of the supplied mock data (data/ is the canonical copy)
utilico_mock_data/
utilico_mock_data.zip

# Superseded first version of POC 1 (single generated-data HTML file)
poc1-disconnect-billing-detector.html

# OS noise
Thumbs.db
.DS_Store
