  "agent_states": ["NEW", "RETRIEVING", "RECONCILING", "RECOMMENDING", "EXECUTING", "VERIFYING", "DRAFTING_OUTPUTS"],
  "terminal_states": ["SEALED", "CANCELLED"],
  "transitions": [
