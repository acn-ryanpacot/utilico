# Copy this file to .env (same folder) and fill in your own values.
# .env is git-ignored: never commit a real key. A process environment variable overrides the file.

# AI model (OpenAI-compatible Chat Completions API)
# Base URL WITHOUT the trailing /chat/completions, e.g. https://api.openai.com/v1
MODEL_API_BASE_URL=https://model-iq.aicore.accenture.com/v1
MODEL_NAME=deepseek-v4-1-flash-1017
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=30
